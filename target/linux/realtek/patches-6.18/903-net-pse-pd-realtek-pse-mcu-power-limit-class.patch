+		}
+
+		p->attrs[k] = NULL;
 
 		p->group.name = devm_kasprintf(pse->dev, GFP_KERNEL, "port%u", i);
 		if (!p->group.name)
@@ -1438,6 +1537,7 @@ static const struct rtpse_mcu_dialect rt
 	.mcu_type_str      = rtpse_mcu_gen2_mcu_type_str,
 	.detect_standard   = 0x0,
 	.detect_legacy     = 0x1,
+	.pw_limit_class    = true,
 	.opcode = {
 		[RTPSE_MCU_CMD_SET_GLOBAL_STATE]	= RTPSE_MCU_OP(0x00),
