+/* Port settings given over ubus (port_config), by interface name: applied
+ * to the port now and again whenever it joins a bridge. Worker thread only. */
+struct port_config_entry {
+    struct list_head list;
+    char name[IFNAMSIZ];
+    CIST_PortConfig cfg;
+};
+static LIST_HEAD(port_configs);
+
+static struct port_config_entry *port_config_find(const char *name)
+{
+    struct port_config_entry *pc;
+    list_for_each_entry(pc, &port_configs, list)
+    {
+        if(!strcmp(pc->name, name))
+            return pc;
+    }
+    return NULL;
+}
+
+static void port_config_apply(port_t *prt, const CIST_PortConfig *cfg)
+{
+    CIST_PortConfig c = *cfg;
+    if(MSTP_IN_set_cist_port_config(prt, &c))
+        ERROR_PRTNAME(prt->bridge, prt, "port config not taken");
+}
+
+void bridge_port_config(const char *name, const CIST_PortConfig *cfg)
+{
+    struct port_config_entry *pc = port_config_find(name);
+    bridge_t *br;
+    port_t *prt;
+
+    if(!pc)
+    {
+        TST((pc = calloc(1, sizeof(*pc))) != NULL,);
+        strncpy(pc->name, name, IFNAMSIZ - 1);
+        list_add_tail(&pc->list, &port_configs);
+    }
+    /* each call says what it sets; keep what an earlier one set */
+    if(cfg->set_admin_edge_port)
+    {
+        pc->cfg.admin_edge_port = cfg->admin_edge_port;
+        pc->cfg.set_admin_edge_port = true;
+    }
+    if(cfg->set_auto_edge_port)
+    {
+        pc->cfg.auto_edge_port = cfg->auto_edge_port;
+        pc->cfg.set_auto_edge_port = true;
+    }
+    if(cfg->set_bpdu_guard_port)
+    {
+        pc->cfg.bpdu_guard_port = cfg->bpdu_guard_port;
+        pc->cfg.set_bpdu_guard_port = true;
+    }
+
+    list_for_each_entry(br, &bridges, list)
+    {
+        list_for_each_entry(prt, &br->ports, br_list)
+        {
+            if(!strcmp(prt->sysdeps.name, name))
+                port_config_apply(prt, &pc->cfg);
+        }
+    }
+}
