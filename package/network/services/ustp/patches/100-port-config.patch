+enum port_config_attr {
+	PORT_CONFIG_NAME,
+	PORT_CONFIG_ADMIN_EDGE,
+	PORT_CONFIG_AUTO_EDGE,
+	PORT_CONFIG_BPDU_GUARD,
+	__PORT_CONFIG_MAX
+};
+
+static const struct blobmsg_policy port_config_policy[__PORT_CONFIG_MAX] = {
+	[PORT_CONFIG_NAME] = { "name", BLOBMSG_TYPE_STRING },
+	[PORT_CONFIG_ADMIN_EDGE] = { "admin_edge", BLOBMSG_TYPE_BOOL },
+	[PORT_CONFIG_AUTO_EDGE] = { "auto_edge", BLOBMSG_TYPE_BOOL },
+	[PORT_CONFIG_BPDU_GUARD] = { "bpdu_guard", BLOBMSG_TYPE_BOOL },
+};
+
+/* A bridge port's edge and BPDU guard settings, by interface name: kept, and
+ * applied again when the port joins a bridge (again). BPDU guard shuts the
+ * port down (IFF_UP off) when a BPDU comes in; setting it up again clears it. */
+static int
+ubus_port_config(struct ubus_context *ctx, struct ubus_object *obj,
+		 struct ubus_request_data *req, const char *method,
+		 struct blob_attr *msg)
+{
+	struct blob_attr *tb[__PORT_CONFIG_MAX], *cur;
+	struct worker_event ev = { .type = WORKER_EV_PORT_CONFIG };
+	const char *name;
+
+	blobmsg_parse(port_config_policy, __PORT_CONFIG_MAX, tb,
+		      blobmsg_data(msg), blobmsg_len(msg));
+
+	if (!tb[PORT_CONFIG_NAME])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	name = blobmsg_get_string(tb[PORT_CONFIG_NAME]);
+	if (!*name || strlen(name) >= sizeof(ev.port_name))
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	strcpy(ev.port_name, name);
+
+	if ((cur = tb[PORT_CONFIG_ADMIN_EDGE]) != NULL) {
+		ev.port_config.admin_edge_port = blobmsg_get_bool(cur);
+		ev.port_config.set_admin_edge_port = true;
+	}
+	if ((cur = tb[PORT_CONFIG_AUTO_EDGE]) != NULL) {
+		ev.port_config.auto_edge_port = blobmsg_get_bool(cur);
+		ev.port_config.set_auto_edge_port = true;
+	}
+	if ((cur = tb[PORT_CONFIG_BPDU_GUARD]) != NULL) {
+		ev.port_config.bpdu_guard_port = blobmsg_get_bool(cur);
+		ev.port_config.set_bpdu_guard_port = true;
+	}
+
+	worker_queue_event(&ev);
+
+	return 0;
+}
