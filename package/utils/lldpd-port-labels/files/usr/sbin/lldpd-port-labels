#!/bin/sh
# Advertise the LuCI switch port labels as LLDP port descriptions.
#
# The labels set on Network > VLAN Switch live in /etc/config/luci as
# switchvlan.port_labels; nothing else in LuCI reads them. This turns them
# into an lldpd drop-in so neighbours see "Uplink Keller" rather than "lan10".

OUT=/etc/lldpd.d/10-port-labels.conf

mkdir -p /etc/lldpd.d

{
	echo "# generated by lldpd-port-labels from luci.port_labels - do not edit"

	for port in $(ls /sys/class/net 2>/dev/null); do
		[ -d "/sys/class/net/$port" ] || continue

		label=$(uci -q get "luci.port_labels.$port") || continue
		[ -n "$label" ] || continue

		# the value lands inside a double-quoted lldpcli argument
		label=$(printf '%s' "$label" | sed 's/[\\"]/\\&/g')

		printf 'configure ports %s lldp portdescription "%s"\n' "$port" "$label"
	done
} > "$OUT.new" && mv "$OUT.new" "$OUT"

# Apply to the running daemon. lldpd only reads the drop-in directory at
# startup via the generated config, so a live change needs this explicitly.
[ -S /var/run/lldpd.socket ] && lldpcli -c "$OUT" >/dev/null 2>&1

exit 0
