#!/bin/sh /etc/rc.common
# /etc/init.d/poe-led

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ -e "/sys/class/leds/green:poe/brightness" ] || {
		echo "poe-led: no rtl9300 PoE LED - is the software-LED patch applied?" >&2
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/sbin/poe-led
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# Restore the LED mode chosen before the last reboot. /var/run/led-mode is
# tmpfs, so the runtime state is always "speed" at boot regardless of what was
# set; the persistent copy lives in uci.
service_started() {
	local mode

	# Factory data for anything that wants it; cheap and done once.
	[ -x /usr/sbin/boardinfo ] && /usr/sbin/boardinfo cache 2>/dev/null
	mode=$(uci -q get poe-led.main.mode)

	case "$mode" in
	poe|off) [ -x /usr/sbin/led-mode ] && /usr/sbin/led-mode "$mode" ;;
	esac
}

stop_service() {
	# hand the port LEDs back to the switch and blank the indicators
	[ -x /usr/sbin/led-mode ] && /usr/sbin/led-mode speed
}

service_triggers() {
	procd_add_reload_trigger "poe-led"
}
