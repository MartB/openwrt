#!/bin/sh /etc/rc.common
# /etc/init.d/poe-led

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ -e "/sys/class/leds/green:poe/brightness" ] || {
		echo "poe-led: no green:poe LED - does the device tree describe it?" >&2
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/sbin/poe-led
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# The LED mode (restored at boot, released at stop) is led-mode's own service.
service_started() {
	# Factory data for anything that wants it; cheap and done once.
	[ -x /usr/sbin/boardinfo ] && /usr/sbin/boardinfo cache 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "poe-led"
}
