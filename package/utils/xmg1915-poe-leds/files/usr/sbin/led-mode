#!/bin/sh
# /usr/sbin/led-mode -- what the front-panel LED-mode button does on ZyNOS.
#
#   led-mode speed    port LEDs show link speed  (hardware scan engine)
#   led-mode poe      port LEDs show PoE class   (painted by poe-led)
#   led-mode off      every front-panel LED dark
#   led-mode toggle   cycles speed -> poe -> off
#   led-mode status
#
# The scan chain only knows link/speed/activity, so PoE display means claiming
# the port LEDs and writing them, as ZyNOS does. This script only flips the
# mode; painting is left to poe-led, which already holds the per-port state.
# Switching back to speed needs no PSE query - the rtl930x-hw trigger hands the
# LEDs to the scan engine, which resumes on its own.

STATE=/var/run/led-mode
PIDFILE=/var/run/poe-led.pid
LEDCACHE=/var/run/poe-led.leds

LED_GREEN="${POE_LED_GREEN:-/sys/class/leds/green:poe}"
LED_RED="${POE_LED_RED:-/sys/class/leds/red:poe}"
LED_BLUE="${POE_LED_BLUE:-}"
if [ -z "$LED_BLUE" ]; then
	for c in /sys/class/leds/blue:poe /sys/class/leds/:indicator; do
		[ -e "$c/brightness" ] && { LED_BLUE=$c; break; }
	done
fi

LED_CLOUD="${POE_LED_CLOUD:-/sys/class/leds/green:cloud}"

# POE_LED_KEEP_POWER=1 keeps the PWR LED lit in dark mode, so the unit does not
# look dead.
KEEP_POWER="${POE_LED_KEEP_POWER:-$(uci -q get poe-led.main.keep_power || echo 0)}"
LED_PWR_GREEN="/sys/class/leds/green:power"
LED_PWR_RED="/sys/class/leds/red:power"

set_led() { [ -e "$1/brightness" ] && echo "$2" > "$1/brightness" 2>/dev/null; }

# Assert the state: "leave it alone" cannot relight a LED an earlier dark-mode
# pass turned off, which stranded it dark in every mode until a reboot.
power_led() {
	set_led "$LED_PWR_GREEN" "$1"
	[ "$1" = 1 ] && set_led "$LED_PWR_RED" 0
	return 0
}

# /var/run/led-mode is what the daemon reads; uci is what survives a reboot.
# Only written on an actual change, so repeated presses cost no overlay write.
persist() {
	[ "$(uci -q get poe-led.main.mode)" = "$1" ] && return 0
	uci -q set poe-led.main.mode="$1" && uci -q commit poe-led
}

indicators_off() {
	set_led "$LED_BLUE" 0
	set_led "$LED_GREEN" 0
	set_led "$LED_RED" 0
	set_led "$LED_CLOUD" 0

	if [ "$KEEP_POWER" = 1 ]; then
		power_led 1
	else
		power_led 0
		set_led "$LED_PWR_RED" 0
	fi
}
PORTS="${POE_LED_PORTS:-lan1 lan2 lan3 lan4 lan5 lan6 lan7 lan8}"
HW_TRIGGER=rtl930x-hw

# LED of one colour on a front-panel port: port_led lan3 green
port_led() { echo "/sys/class/leds/$2:lan-${1#lan}"; }

# Claim (none) or release ($HW_TRIGGER) every port LED.
port_leds_trigger() {
	local p c

	for p in $PORTS; do
		for c in blue green red; do
			echo "$1" > "$(port_led "$p" "$c")/trigger" || return 1
		done
	done
}

need_leds() {
	[ -e "$(port_led "${PORTS%% *}" blue)/trigger" ] && return 0
	echo "led-mode: no port LEDs - does the device tree describe them?" >&2
	return 1
}

# Ask a running poe-led to repaint. Non-zero if there is no daemon, in which
# case we paint it ourselves.
nudge() {
	local pid

	[ -r "$PIDFILE" ] || return 1
	# the redirect must precede 2>/dev/null, or ash reports the failed open
	# before stderr is silenced
	read -r pid 2>/dev/null < "$PIDFILE" || return 1
	[ -n "$pid" ] || return 1

	kill -USR1 "$pid" 2>/dev/null
}

# Repaint from what poe-led published: 24 sysfs writes and no MCU traffic,
# instead of ~1.2s of ethtool. Falls back to the MCU if no daemon has run.
paint_from_cache() {
	local port b g r n=0

	[ -s "$LEDCACHE" ] || return 1

	while read -r port b g r; do
		[ -n "$port" ] || continue
		set_led "$(port_led "$port" blue)" "$b" || return 1
		set_led "$(port_led "$port" green)" "$g" || return 1
		set_led "$(port_led "$port" red)" "$r" || return 1
		n=$((n + 1))
	done < "$LEDCACHE"

	[ "$n" -gt 0 ]
}

# One ethtool call per port. The number is anchored after the keyword, or
# "Clause 33 PSE Power Class: 4" yields 33.
paint_poe() {
	local port out class blue green red

	# Without ethtool every port reads as "no PD" and the panel goes dark,
	# which looks like a broken toggle rather than a missing tool.
	command -v ethtool >/dev/null || {
		echo "led-mode: ethtool not found in PATH ($PATH)" >&2
		return 1
	}

	for port in $PORTS; do
		blue=0; green=0; red=0

		if [ -d "/sys/class/net/$port" ] &&
		   out=$(ethtool --show-pse "$port" 2>/dev/null) &&
		   printf '%s\n' "$out" | grep -i 'detection status' | grep -qi delivering
		then
			class=$(printf '%s\n' "$out" |
				sed -n 's/.*[Cc]lass[^0-9]*\([0-9][0-9]*\).*/\1/p' | head -1)
			case "${class:-0}" in
			0|1|2|3) green=1; red=1 ;;   # 802.3af -> yellow
			4)       green=1 ;;          # 802.3at -> green
			*)       blue=1 ;;           # 802.3bt -> blue
			esac
		fi

		set_led "$(port_led "$port" blue)" "$blue" || return 1
		set_led "$(port_led "$port" green)" "$green" || return 1
		set_led "$(port_led "$port" red)" "$red" || return 1
	done
}

mode_poe() {
	echo poe > "$STATE"
	persist poe

	# Indicator first, so the panel acknowledges the keypress immediately.
	power_led 1
	set_led "$LED_BLUE" 1
	set_led "$LED_GREEN" 0
	set_led "$LED_RED" 0

	port_leds_trigger none || return 1

	# Only nudge the daemon when we fell back to the MCU ourselves, so what
	# it publishes gets refreshed.
	if paint_from_cache; then
		return 0
	fi

	paint_poe
	nudge
	return 0
}

# Dark mode turns every port LED off. Writing 0 also drops the hardware
# trigger, so the scan engine can not light it from link state.
mode_off() {
	local p c

	echo off > "$STATE"
	persist off
	indicators_off

	for p in $PORTS; do
		for c in blue green red; do
			set_led "$(port_led "$p" "$c")" 0 || return 1
		done
	done

	nudge          # so the daemon stops repainting
	return 0
}

mode_speed() {
	echo speed > "$STATE"
	persist speed
	set_led "$LED_BLUE" 0
	# Leaving dark mode: the unit is powered, so the PWR LED belongs on
	# whatever keep_power says - that option only governs dark mode.
	power_led 1
	port_leds_trigger "$HW_TRIGGER" || return 1
	nudge          # let a running daemon drop the port LEDs from its next pass
	return 0
}

case "${1:-status}" in
poe)    need_leds && mode_poe ;;
speed)  need_leds && mode_speed ;;
off)    need_leds && mode_off ;;
toggle)
	need_leds || exit 1
	# speed -> poe -> off -> speed
	case "$(cat "$STATE" 2>/dev/null)" in
	speed|"") mode_poe ;;
	poe)      mode_off ;;
	*)        mode_speed ;;
	esac
	;;
status) cat "$STATE" 2>/dev/null || echo speed ;;
*)
	echo "usage: ${0##*/} {speed|poe|off|toggle|status}" >&2
	exit 1
	;;
esac
