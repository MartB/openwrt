#!/bin/sh /etc/rc.common
# Reapply the per-port settings netifd does not know about.
#
# It restores pse, pse_power_limit, pse_priority and eee itself. detection_legacy
# is a PSE sysfs file and aldps a PHY one, so both would revert on every reboot --
# and a legacy PD is exactly the device that would then stop coming up. Read from
# the same device section as the rest.

START=96

pse_root() {
	local f

	for f in /sys/bus/serial/devices/*/port0/detection_legacy \
		 /sys/devices/platform/*/*/*/port0/detection_legacy \
		 /sys/devices/platform/*/*/port0/detection_legacy; do
		[ -e "$f" ] && { dirname "$(dirname "$f")"; return 0; }
	done

	return 1
}

apply_port() {
	local sid="$1" name legacy idx

	config_get name "$sid" name
	config_get legacy "$sid" pse_detection_legacy

	[ -n "$name" ] && [ -n "$legacy" ] || return 0

	# Port <N> is the PSE index, which on this family is the lanN number
	# minus one: PoE sits on the first eight copper ports.
	case "$name" in
	lan[0-9]|lan[0-9][0-9]) idx=$(( ${name#lan} - 1 )) ;;
	*) return 0 ;;
	esac

	[ -w "$ROOT/port$idx/detection_legacy" ] || return 0

	echo "$legacy" > "$ROOT/port$idx/detection_legacy"
}

apply_aldps() {
	local sid="$1" name aldps addr d

	config_get name "$sid" name
	config_get aldps "$sid" phy_aldps

	[ -n "$name" ] && [ -n "$aldps" ] || return 0

	# No phydev symlink on DSA user ports; copper lanN is PHY address N-1.
	case "$name" in
	lan[0-9]|lan[0-9][0-9]) addr=$(( ${name#lan} - 1 )) ;;
	*) return 0 ;;
	esac

	for d in /sys/bus/mdio_bus/devices/*:$(printf '%02x' $addr); do
		[ -w "$d/aldps" ] || continue
		echo "$aldps" > "$d/aldps"
		return 0
	done
}

start() {
	config_load network
	config_foreach apply_aldps device

	ROOT=$(pse_root) || return 0
	config_foreach apply_port device
}
